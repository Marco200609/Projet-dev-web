<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>{% block title %}{% endblock %} Juniors </title>
        <meta name="description" content="Site de mise en relation entre jeunes diplômés et entreprises pour des stages, alternances et emplois. Découvrez des opportunités de carrière adaptées à votre profil et développez votre avenir professionnel avec Juniors.">

        <link rel="stylesheet" href="/Assets/style.css">
        <link rel="stylesheet" href="/Assets/accueil.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

        <meta name="viewport" content="width=device-width, initial-scale=1.0">
	</head>
	<body class="{% block BodyAcceuil %}{% endblock %}">  

        {% block header %}{% endblock %}

        <nav class="navBar {% block Animation %}{% endblock %}">
                <div class="LogoNav">
                        <img src="/Picture/LogoNav1.png" class="LogoNav1" alt="LittleLogo">
                        <img src="/Picture/LogoNav2.png" class="LogoNav2">
                </div>

                <input type="checkbox" id="menu-toggle" class="menu-checkbox">
                <label for="menu-toggle" class="burger-label">
                        <span></span>
                        <span></span>
                        <span></span>
                </label>

        {% block links %}{% endblock %}

        </nav>

        {% block main %}{% endblock %}

        {{ include('_footer.html.twig') }}

	</body>

        {% block scripts %}{% endblock %}
</html>