<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Formulaire candidature</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/Assets/style.css">
    <link rel="stylesheet" href="/Assets/formulaire_candidature.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
<nav class="navBar">
    <div class="LogoNav">
        <img src="../Images/LogoNav1.png" class="LogoNav1" alt="LittleLogo">
        <img src="../Images/LogoNav2.png" class="LogoNav2">
    </div>

    <input type="checkbox" id="menu-toggle" class="menu-checkbox">
    <label for="menu-toggle" class="burger-label">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <div class="links">
        <a href="../index.html" class="active">Accueil</a>
        <a href="Offres.html">Offre</a>
        <a href="Entreprises.html">Entreprise</a>
        <a href="Connexion.html">Mon Compte</a>
    </div>
</nav>

<main>
    {% if errors is defined and errors|length > 0 %}
        <div>
            <ul>
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <section>
        <h1>{{ offre.titre }}</h1>
        <div class="zone_info">
            <span class="entreprise"> {{ offre.nom }}</span>
            <span class="domaine">{{ offre.domaine }}</span>
            <span class="localisation"><i class="bi bi-geo-alt"></i> {{ offre.nom_ville }}</span>
            <span><strong>Reference :</strong> {{ offre.id_offre }} </span>
        </div>

        <form method="post" action="/offres/formcandidature/" enctype="multipart/form-data">

        <input type="hidden" name="id_offre" value="{{ offre.id_offre }}">

            <div class="form-group">
                <label for="filecv">Lettre de motivation :</label><br>
                <textarea name="lettre_motivation" rows="10" cols="75" placeholder="Votre message à destination du recruteur" minlength="20" required></textarea>
            </div>

            <div class="form-group">
                <label for="filecv">CV (PDF) :</label><br>
                <input name="cv" type="file" id="filecv" accept="application/pdf" required>
            </div>

            <div class="form-group">
                <input type="submit" value="Envoyer">
                <input type="reset" value="Annuler">
            </div>

        </form>
    </section>
</main>

<footer>
    <p> © 2026 - All Right Reserved </p>
</footer>
</body>
</html>