<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Offre 1 : Stage développement web</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/Assets/style.css">
    <link rel="stylesheet" href="/Assets/detail_offre.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
<nav class="navBar">
    <div class="LogoNav">
        <img src="../Images/LogoNav1.png" class="LogoNav1" alt="LittleLogo">
        <img src="../Images/LogoNav2.png" class="LogoNav2">
    </div>

    <input type="checkbox" id="menu-toggle" class="menu-checkbox">
    <label for="menu-toggle" class="burger-label">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <div class="links">
        <a href="../index.html" >Accueil</a>
        <a href="Offres.html" class="active">Offre</a>
        <a href="Entreprises.html">Entreprise</a>
        <a href="Connexion.html">Mon Compte</a>
    </div>
</nav>

<main>
    <section class="offre-det">
        <div class="offre-header">
            <span class="date"><i class="bi bi-calendar"></i> {{ off.date_creation }}</span>
            {% if off.new %}
                <span class="nouveau">Nouveau</span>
            {% endif %}
            {% if off.in_wishlist %}
{#                ToDo wishlist #}
                <input type="checkbox" id="wish{{ off.id_offre }}" class="wishlist-checkbox" checked />
                <label for="wish{{ off.id_offre }}" class="wishlist-label">
                    <i class="bi bi-heart-fill"></i>
                </label>
            {% else %}
                <input type="checkbox" id="wish{{ off.id_offre }}" class="wishlist-checkbox" />
                <label for="wish{{ off.id_offre }}" class="wishlist-label">
                    <i class="bi bi-heart"></i>
                </label>
            {% endif %}
        </div>
        <h1>{{ off.titre }}</h1>
        <div class="face_a_face">
            <div class="offre-info">
                <span class="entreprise">{{ off.nom }}</span>
                <span class="domaine">{{ off.domaine }}</span>
            </div>
            <div class="offre-details">
                <span class="localisation"><i class="bi bi-geo-alt"></i> {{ off.nom_ville }}</span>
                <span class="salaire"><i class="bi bi-file-earmark-text"></i>{{ off.nom_contrat }}</span>
            </div>
        </div>
        <p class="descriptif"><strong>Descriptif :</strong>
            {{ off.descriptif }}
        </p>
        <div class="competences-ligne-postuler">
            <div class="gauche">
                <strong>Compétences liées :</strong>
                <div class="offre-competences">
                    {% for competence in off.competences|split(',') %}
                        <span>{{ competence }}</span>
                    {% endfor %}
                </div>
            </div>
            {% if user_id != 0 %}
            <a href="/entreprises/postuler/{{ off.id_offre }}" class="postuler-button">Postuler</a>
            {% endif %}
        </div>
        <p><strong>Reference :</strong> {{ off.id_offre }} </p>
    </section>

</main>

<footer>
    <p> © 2026 - All Right Reserved </p>
</footer>
</body>
</html>