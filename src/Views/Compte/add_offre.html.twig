{% extends 'base.html.twig' %}

{% block links %}{{ include('Compte/_links.html.twig') }}{% endblock %}

{% block main %}
<main>
    <section>
        {% if errors is defined and errors|length > 0 %}
            <div>
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <h1>Ajouter ou modifier votre Offre</h1>

        <form method="post" class="candidature" action="/offres/{{ update ? 'formupdate' : 'formadd' }}/{{ id_offre|default('') }}">

            <input type="hidden" name="id_offre" value="{{ id_entreprise }}">

            <div class="form-group">
                <label>
                    <input type="text" name="titre" placeholder="Titre de l'offre" value="{{ off.titre }}" minlength="1" required>
                </label>
                <label>
                    <input type="text" name="entreprise" placeholder="entreprise" value="{{ off.nom }}" minlength="1" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="email" name="mail" placeholder="Adresse e-mail" value="{{ off.email }}" required>
                </label>
                <label>
                    <input type="tel" name="telephone" placeholder="Numéro de téléphone" value="{{ off.telephone }}" pattern="[0-9]{10}" title="Veuillez entrer un numéro de téléphone valide à 10 chiffres" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="domaine" placeholder="domaine de l'offre" value="{{ off.domaine }}" required>
                </label>
                <label>
                    <select name="contrat">
                        {% for c in liste_contrats %}
                            <option value="{{ c }}" {% if c == off.nom_contrat %} selected{% endif %}>{{ c }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="duree" placeholder="duree du contrat" value="{{ off.duree }}">
                </label>
                <select name="unite_duree">
                    <option value="Aucune">Aucune</option>
                    {% for d in unites_duree %}
                    <option value="{{ d }}" {% if d == off.nom_unite %} selected{% endif %}>{{ d }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
            {#        ToDo : gerer plusieurs compétences        #}
                <label>
                    <input type="text" name="competences" placeholder="compétences entre virgules" value="{{ off.competences }}">
                </label>
            </div>


            <div class="form-group">
                <label>
                    <textarea name="descriptif" rows="10" cols="75" placeholder="Description de votre offre" minlength="20" required>{{ off.descriptif }}</textarea>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="pays" placeholder="pays" value="{{ off.nom_pays }}" required>
                </label>
                <label>
                    <input type="text" name="departement" placeholder="département" value="{{ off.departement }}" required>
                </label>
            </div>
            <div class="form-group">
                <label>
                    <input type="text" name="ville" placeholder="ville" value="{{ off.nom_ville }}" required>
                </label>
                <label>
                    <input type="text" name="adresse" placeholder="adresse" value="{{ off.adresse }}" required>
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="Envoyer">
                <input type="reset" value="Annuler">
            </div>

        </form>
    </section>
</main>

{% endblock %}
