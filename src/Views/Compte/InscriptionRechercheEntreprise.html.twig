{% extends 'base.html.twig' %}

{% block title %}Inscription entreprise - {% endblock %}
{% block links %}{{ include('Compte/_links.html.twig') }}{% endblock %}

{% block main %}

<main>

    {% if premier_compte %}
    <h1>Création d'un compte de gestion de l'entreprise</h1>

    {% elseif not premier_compte%}
    <h1>Ajout d'un compte de gestion d'entreprise</h1>
    {% endif %}


    {% if errors is defined and errors %}
        <div>
            <h3>Erreurs :</h3>
            <ul>
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}


    <form class="Finder" method="post" action="/CompteInscription/Traitement">

        <section>
            <label for="nom">Nom *</label>
            <input
                    id="nom"
                    name="nom"
                    type="text"
                    value="{{ nom ?? '' }}"
                    required>
        </section>
        <br>

        <section>
            <label for="prenom">Prénom *</label>
            <input
                    id="prenom"
                    name="prenom"
                    type="text"
                    value="{{ prenom ?? '' }}"
                    required>
        </section>

        <input type="hidden" name="role" value="2">


        {% if not premier_compte %}
        <section>
            <label for="codeEntreprise">Recherche une entreprise déjà présente *</label>
            <input
                    id="codeEntreprise"
                    name="codeEntreprise"
                    type="text"
                    value="{{ code_entreprise ?? '' }}"
                    required>
        </section>
        {% endif %}

        <section>
            <label for="email">Email *</label>
            <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="username"
                    value="{{ email ?? '' }}"
                    required>
        </section>

        <section>
            <label for="current-password">Mot de passe *</label>

            <div class="password-wrapper">
                <input
                        id ="current-password"
                        class = "password-input"
                        name="password"
                        type="password"
                        autocomplete="current-password"
                        required>

                <button
                        type="button"
                        class ="toggle-password"
                        aria-label="Afficher le mot de passe">

                    <svg class = "eye-closed bi bi-eye-slash" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                        <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                        <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                    </svg>

                    <svg class= "eye-open bi bi-eye hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" >
                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                    </svg>

                </button>
            </div>

            <div id="password-constraints">Huit ou plus de caractères avec au moins une minuscule, une majuscule et un caractère spécial.
            </div>
        </section>


        <input type="hidden" name="premier_compte" value="{{ premier_compte ? 1 : 0 }}">
        <button id="signin" type="submit">Créer un compte</button>
    </form>



    <form action="/CompteConnexion" class="centrerPage">
        <button class="postuler-button">Vous avez un compte ? Connectez-vous</button>
    </form>

</main>

{% endblock %}

{% block scripts %}
<script src="/Assets/ConnexionIns.js"></script>
{#<script src="../javascript/Connexion.js"></script> //ici pas besoin mais je laisse au cas où#}
{% endblock %}

