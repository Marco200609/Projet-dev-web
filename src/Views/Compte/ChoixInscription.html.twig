{% extends 'base.html.twig' %}

{% block links %}{{ include('Compte/_links.html.twig') }}{% endblock %}

{% block main %}

<main>

    <h1>Quel compte souhaitez vous créer ?</h1>

    <div class="liste-compte">

        <a href="/CompteInscription/Pilote" class="link-compte"><div class="box-annonce">
            <h2>Pilote</h2>
            <p>Pour gérer les étudiants et les suivre.</p>
            </div>
        </a>

        <a href= '/CompteInscription/Entreprise' class="link-compte">
        <div class="box-annonce">
            <h2>Entreprise</h2>
            <p>Pour publier des offres.</p>
        </div>
        </a>

        <a href="/CompteInscription/Etudiant" class="link-compte">
        <div class="box-annonce">
            <h2>Étudiant</h2>
            <p>Pour rechercher et postuler à des offres.</p>
            </div>
        </a>

    </div>

    <form action="/CompteConnexion" class="centrerPage">
        <button class="postuler-button">Vous avez un compte ? Connectez-vous</button>
    </form>

</main>

{% endblock %}
