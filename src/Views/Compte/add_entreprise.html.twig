{% extends 'base.html.twig' %}

{% block title %}Ajouter une entreprise - {% endblock %}
{% block links %}{{ include('Compte/_links.html.twig') }}{% endblock %}

{% block main %}

<main>
    <section>
        {% if errors is defined and errors|length > 0 %}
            <div>
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <h1>Ajouter votre entreprise</h1>

        <form method="post" action="/entreprises/{{ update ? 'formupdate' : 'formadd' }}/{{ id_entreprise|default('') }}" class="candidature">

            <input type="hidden" name="id_entreprise" value="{{ id_entreprise }}">

            <div class="form-group">
                <label>
                    <input type="text" name="nom" placeholder="entreprise" value="{{ ent.nom }}" minlength="1" required>
                </label>
                <label>
                    <input type="url" name="logo" placeholder="URL logo" value="{{ ent.logo }}" minlength="1" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="email" name="mail" placeholder="Adresse e-mail" value="{{ ent.email }}" required>
                </label>

                <label>
                    <input type="tel" name="telephone" placeholder="Numéro de téléphone" value="{{ ent.telephone }}" pattern="[0-9]{10}" title="Veuillez entrer un numéro de téléphone valide à 10 chiffres" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="nb_employe" placeholder="nombre d'employé" value="{{ ent.nb_employe }}" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <textarea name="description" rows="10" cols="75" placeholder="Description de votre entreprise" minlength="20" required>{{ ent.descriptif }}</textarea>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="pays" placeholder="pays" value="{{ ent.nom_pays }}" required>
                </label>
                <label>
                    <input type="text" name="departement" placeholder="département" value="{{ ent.departement }}" required>
                </label>
            </div>
            <div class="form-group">
                <label>
                    <input type="text" name="ville" placeholder="ville" value="{{ ent.nom_ville }}" required>
                </label>
                <label>
                    <input type="text" name="adresse" placeholder="adresse" value="{{ ent.adresse }}" required>
                </label>
            </div>

        <input type="hidden" name="premier_compte" value="{{ premier_compte|default(0) }}">
            <div class="form-group">
                <input type="submit" value="Envoyer">
                <input type="reset" value="Annuler">
            </div>

        </form>
    </section>
</main>

{% endblock %}
