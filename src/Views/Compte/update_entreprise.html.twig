{% extends 'base.html.twig' %}

{% block links %}{{ include('Compte/_links.html.twig') }}{% endblock %}

{% block main %}

<main>
    <section>
        {% if errors is defined and errors|length > 0 %}
            <div>
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <h1>Ajouter votre entreprise</h1>

        <form method="post" action="/entreprises/formadd">
            <div class="form-group">
                <label>
                    <input type="text" name="nom" placeholder="entreprise" minlength="1" required>
                </label>
                <label>
                    <input type="url" name="logo" placeholder="URL logo" minlength="1" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="email" name="mail" placeholder="Adresse e-mail" required>
                </label>
                <label>
                    <input type="tel" name="telephone" placeholder="Numéro de téléphone" pattern="[0-9]{10}" title="Veuillez entrer un numéro de téléphone valide à 10 chiffres" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="nb_employe" placeholder="nombre d'employé" required>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <textarea name="description" rows="10" cols="75" placeholder="Description de votre entreprise" minlength="20" required></textarea>
                </label>
            </div>

            <div class="form-group">
                <label>
                    <input type="text" name="pays" placeholder="pays" required>
                </label>
                <label>
                    <input type="text" name="departement" placeholder="département" required>
                </label>
            </div>
            <div class="form-group">
                <label>
                    <input type="text" name="ville" placeholder="ville" required>
                </label>
                <label>
                    <input type="text" name="adresse" placeholder="adresse" required>
                </label>
            </div>

            <div class="form-group">
                <input type="submit" value="Envoyer">
                <input type="reset" value="Annuler">
            </div>

        </form>
    </section>
</main>

{% endblock %}
