<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Compte entreprise</title>
    <link rel="stylesheet" href="../assets/style.css">
    <link rel="stylesheet" href="../assets/comptes.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>

<nav class="navBar">
    <div class="LogoNav">
        <img src="../Images/LogoNav1.png" class="LogoNav1" alt="LittleLogo">
        <img src="../Images/LogoNav2.png" class="LogoNav2">
    </div>

    <input type="checkbox" id="menu-toggle" class="menu-checkbox">
    <label for="menu-toggle" class="burger-label">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <div class="links">
        <a href="../index.html">Accueil</a>
        <a href="Offres.html">Offre</a>
        <a href="Entreprises.html">Entreprise</a>
        <a href="Connexion.html"  class="active">Mon Compte</a>
    </div>
</nav>

<main class="dashboard">
    <div class="profile-overview">
        <div class="glass-card group-card">
            <h3><i class="bi bi-building"></i> {{ entreprise.nom|default('Null')  }}</h3>
            <div class="group-details">
                <p><strong>Secteur :</strong>{{ entreprise.descriptif|default('null') }}</p>
                <p><strong>Localisation :</strong>{{ entreprise.nom_ville|default('null') }}</p>
                <p><strong>Recruteur :</strong>{{ entreprise.recruteur_prenom|default('null') }} {{ entreprise.recruteur_nom|default(null) }}</p>
            </div>
        </div>




        <div class="stats-row">
            <div class="mini-stat">
                <span class="number">{{ stats.nb_offres|default(0) }}</span>
                <span class="label">Total offres</span>
            </div>

            <div class="mini-stat">
                <span class="number">{{ stats.nb_actives|default(offres|length) }}</span>
                <span class="label">Offres actives</span>
            </div>

            <div class="mini-stat success">
                <span class="number">0</span>
                <span class="label">Offres en pause</span>
            </div>
        </div>
    </div>

    <section class="glass-card wishlist-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3><i class="bi bi-megaphone-fill"></i> Offres en cours</h3>
            <a href="/offres/add" class="btn-add-offer"><i class="bi bi-plus-circle-fill"></i> Publier une annonce</a>
        </div>

        <div class="wishlist-container">
            {% if offres|length > 0 %}
                {% for offre in offres %}
                    <div class="wishlist-item">
                        <div class="wish-info">
                            <h4>{{ offre.titre }}</h4>
                            <p>{{ offre.nom_contrat }} • {{ offre.nb_cand }} candidatures</p>
                            <a href="/offres/update/{{ offre.id_offre }}" class="view-link">Modifier l'offre <i class="bi bi-pencil-square"></i></a>
                        </div>
                        <div class="action-buttons">
                            <button class="action-btn pause" title="Mettre en pause" data-id="{{ offre.id_offre }}"><i class="bi bi-pause-circle"></i></button>
                            <button class="action-btn delete" title="Supprimer l'annonce" data-id="{{ offre.id_offre }}"><i class="bi bi-trash3-fill"></i></button>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div style="text-align: center; padding: 40px; color: #666;">
                    Vous n'avez aucune offre en cours. <a href="/offres/add">Publiez-en une maintenant</a> !
                </div>
            {% endif %}
        </div>
    </section>

    <section class="glass-card wishlist-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h3><i class="bi bi-pause-circle-fill"></i> Offres en Pause</h3>
        </div>

        <div class="wishlist-container">
            {% if offres_pause|length > 0 %}
                {% for offre in offres_pause %}
                    <div class="wishlist-item">
                        <div class="wish-info">
                            <h4>{{ offre.titre }}</h4>
                            <p>{{ offre.nom_contrat }} • {{ offre.nb_cand }} candidatures</p>
                            <a href="/offres/update/{{ offre.id_offre }}" class="view-link">
                                Modifier l'offre <i class="bi bi-pencil-square"></i>
                            </a>
                        </div>
                        <div class="action-buttons">
                            <button class="action-btn resume" title="Remettre en actif" data-id="{{ offre.id_offre }}">
                                <i class="bi bi-play-circle-fill"></i>
                            </button>
                            <button class="action-btn delete" title="Supprimer l'annonce" data-id="{{ offre.id_offre }}">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div style="text-align: center; padding: 40px; color: #666;"> Aucune offre en pause.</div>
            {% endif %}
        </div>
    </section>
</main>

<footer>
    <p> © 2026 - Espace Recruteur </p>
</footer>

</body>
</html>