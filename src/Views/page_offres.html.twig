<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Offres</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/Assets/style.css">
    <link rel="stylesheet" href="/Assets/offres.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/Assets/recherche.css">
</head>
<body>
<nav class="navBar">
    <div class="LogoNav">
        <img src="../Images/LogoNav1.png" class="LogoNav1" alt="LittleLogo">
        <img src="../Images/LogoNav2.png" class="LogoNav2">
    </div>

    <input type="checkbox" id="menu-toggle" class="menu-checkbox">
    <label for="menu-toggle" class="burger-label">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <div class="links">
        <a href="/">Accueil</a>
        <a href="/offres" class="active">Offre</a>
        <a href="/entreprises">Entreprise</a>
        <a href="Connexion.html">Mon Compte</a>
    </div>
</nav>


<main>

    <h1>Rechercher une offre :</h1>

    {% include 'recherche_offre.html.twig' with {
        parpage: parpage,
        nom_offre: nom_offre,
        liste_contrats: liste_contrats,
        contrats: contrats,
        liste_domaines: liste_domaines,
        domaines: domaines,
        liste_competences: liste_competences,
        competences: competences,
        ville: ville,
        liste_ville_offres: liste_ville_offres,
        entreprise: entreprise,
        liste_nom_entreprises: liste_nom_entreprises,
    } %}

    {% if offres is empty %}
        <h1> Aucune offre trouvée </h1>
    {% else %}
        <h1> Offres disponibles </h1>
    {% endif %}

    <section class="liste_offres">
        {% for off in offres %}
            {% include 'offre.html.twig' with {
                off: off,
                session: session
            } %}
        {% endfor %}

    </section>

    <nav class="pagination navBar">
        {% include 'pagination.html.twig' with {
            pagination: pagination
        } %}

        <form method="get" action="" class="pagination-form">
            <input type="hidden" name="nomOffre" value="{{ nom_offre }}">
            <input type="hidden" name="ville" value="{{ ville }}">
            <input type="hidden" name="entreprise" value="{{ entreprise }}">
            {% for c in contrats %}
                <input type="hidden" name="contrats[]" value="{{ c }}">
            {% endfor %}
            {% for d in domaines %}
                <input type="hidden" name="domaines[]" value="{{ d }}">
            {% endfor %}
            {% for comp in competences %}
                <input type="hidden" name="competences[]" value="{{ comp }}">
            {% endfor %}

            <select name="parpage" id="parpage" onchange="this.form.submit()">
                <option value="12" {% if parpage == 12 %}selected{% endif %}>12</option>
                <option value="24" {% if parpage == 24 %}selected{% endif %}>24</option>
                <option value="48" {% if parpage == 48 %}selected{% endif %}>48</option>
                <option value="96" {% if parpage == 96 %}selected{% endif %}>96</option>
                <option value="-1" {% if parpage == -1 %}selected{% endif %}>illimité</option>
            </select>
        </form>
    </nav>

</main>


<footer>
    <p> © 2026 - All Right Reserved </p>
</footer>
</body>
</html>