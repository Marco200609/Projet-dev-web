<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Compte etudiant</title>
    <link rel="stylesheet" href="/Assets/style.css">
    <link rel="stylesheet" href="/Assets/comptes.css">
    <link rel="stylesheet" href="/Assets/offres.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
<nav class="navBar">
    <div class="LogoNav">
        <img src="Images/LogoNav1.png" class="LogoNav1" alt="LittleLogo">
        <img src="Images/LogoNav2.png" class="LogoNav2">
    </div>

    <input type="checkbox" id="menu-toggle" class="menu-checkbox">
    <label for="menu-toggle" class="burger-label">
        <span></span>
        <span></span>
        <span></span>
    </label>



    <div class="links">

        <a href="index.html" class="active">Accueil</a>
        <a href="Pages/Offres.html">Offre</a>
        <a href="Pages/Entreprises.html">Entreprise</a>
        <a href="Pages/Connexion.html">Mon Compte</a>

    </div>
</nav>
<main>
    <section class="dashboard">
        <div class="profile-overview">
            <div class="glass-card group-card">
                <h3><i class="bi bi-people-fill"></i> {{ NomEtGroupe.nom }} {{ NomEtGroupe.prenom }}</h3>
                <div class="group-details">
                    <p><strong>Promotion :</strong> {{ NomEtGroupe.nom_groupe }} </p>
                    <p><strong>Référent :</strong> {{ NomPilote.nom }} {{ NomPilote.prenom }}</p>
                </div>
            </div>

            <div class="stats-row">
                <div class="mini-stat">
                    <span class="number">{{ NbCandidatures }}</span>
                    <span class="label">Candidatures Envoyées</span>
                </div>
            </div>
        </div>

        <section class="glass-card wishlist-section">
            <h3><i class="bi bi-heart-fill"></i> Ma Wishlist</h3>
            <div class="wishlist-container">
                {% if wishlist is not empty %}
                <div class="wishlist-item">
                        {% for off in wishlist %}
                            {% include 'offre.html.twig' with {
                                off: off,
                                id_role: id_role
                            } %}
                        {% endfor %}
                </div>

                {% else %}
                    <span class="wishlist_label">Aucune Offre en Wishlist</span>
                {% endif %}
            </div>

        </section>


        <section class="glass-card table-section">
            <h3><i class="bi bi-graph-up-arrow"></i> Suivi des candidatures</h3>
            <div class="table-wrapper"><table class="stats-table">
                    <thead>
                    <tr>
                        <th>Entreprise</th>
                        <th>Type</th>
                        <th>Poste</th>
                        <th>Date d'envoi</th>
                        <th>Lien</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for cand in candidatures %}
                        <tr>
                            <td>{{ cand.nom }}</td>
                            <td>{{ cand.nom_contrat }}</td>
                            <td>{{ cand.titre }}</td>
                            <td>{{ cand.date_candidature|date('d/m/Y') }}</td>
                            <td><a href="/detail_offre/{{ cand.id_offre }}" class="wishlist_link"><i class="bi bi-box-arrow-up-right"></i></a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table> </div>
            </section>
        </section>
    </section>
</main>

<footer>
    <p> © 2026 - All Right Reserved </p>
</footer>
{% if id_role == 1 %}
    <script src="/Assets/wishlist.js"></script>
{% endif %}
</body>
</html>